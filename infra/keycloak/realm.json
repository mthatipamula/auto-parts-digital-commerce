{
  "realm": "auto-parts",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": { "realm": [
    { "name": "customer", "description": "Shop, check out, see own orders" },
    { "name": "pro", "description": "Commercial (B2B) buyer: account pricing, charge to account, delivery" },
    { "name": "associate", "description": "Store team member: inventory and any order" },
    { "name": "admin", "description": "Operations: fault injection, diagnostics" }
  ] },
  "clients": [
    {
      "clientId": "storefront",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${WEB_ORIGIN:http://localhost:5173}/*"],
      "webOrigins": ["${WEB_ORIGIN:http://localhost:5173}"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "${WEB_ORIGIN:http://localhost:5173}/*" }
    },
    {
      "clientId": "test-harness",
      "publicClient": false,
      "secret": "${TEST_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    { "id": "0f6b1c3a-1d2e-4c5b-9a01-7e1c0b0a1001", "username": "rick", "firstName": "Rick", "lastName": "Owner", "email": "rick@ricks-automotive.example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_RICK_PASSWORD}", "temporary": false }], "realmRoles": ["pro"] },
    { "id": "0f6b1c3a-1d2e-4c5b-9a01-7e1c0b0a1002", "username": "jordan", "firstName": "Jordan", "lastName": "Technician", "email": "jordan@ricks-automotive.example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_JORDAN_PASSWORD}", "temporary": false }], "realmRoles": ["pro"] },
    { "id": "0f6b1c3a-1d2e-4c5b-9a01-7e1c0b0a2001", "username": "mike", "firstName": "Mike", "lastName": "Mechanic", "email": "mike@mobile-mechanic.example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_MIKE_PASSWORD}", "temporary": false }], "realmRoles": ["pro"] },
    { "username": "customer", "firstName": "Casey", "lastName": "Customer", "email": "customer@example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_CUSTOMER_PASSWORD}", "temporary": false }], "realmRoles": ["customer"] },
    { "username": "associate", "firstName": "Sam", "lastName": "Associate", "email": "associate@example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_ASSOCIATE_PASSWORD}", "temporary": false }], "realmRoles": ["associate", "customer"] },
    { "username": "admin", "firstName": "Avery", "lastName": "Admin", "email": "admin@example.test", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_ADMIN_PASSWORD}", "temporary": false }], "realmRoles": ["admin", "associate", "customer"] }
  ]
}
