# Local (docker compose) storefront config: /api goes through Kong instead of straight to the gateway.
# Mounted by compose into /etc/nginx/templates/, so nginx fills in ${KONG_STOREFRONT_KEY} at startup.
# The image's own web/nginx.conf (gateway direct) is unchanged and still what GKE uses.
server {
  listen 8080;
  root /usr/share/nginx/html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $edge http://kong:8000;
  location /api/ {
    proxy_pass $edge;
    proxy_read_timeout 60s;
    # The storefront is a Kong consumer like any other app; its key is added here, server side.
    proxy_set_header x-api-key "${KONG_STOREFRONT_KEY}";
  }
  location = /config.js { add_header Cache-Control "no-store"; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { try_files $uri /index.html; }
}
